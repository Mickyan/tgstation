/obj/item/clothing/under/peliskpalo_rig
	name = "vintage peliskpalo rig"
	desc = "Although the more modern rules of peliskpalo have reduced the amount and severity of injuries sustained, the almost complete lack of personal protection remains a point of pride for many involved in the sport. The 'Game of War' is not for the faint of heart."
